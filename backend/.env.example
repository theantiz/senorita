# --- Database ---
DATABASE_URL=postgresql+asyncpg://senorita:senorita@localhost:5432/senorita

# --- Auth ---
SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Gemini AI ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# --- Embeddings ---
EMBEDDING_MODEL=text-embedding-004

# --- Server ---
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- Workers ---
REMINDER_POLL_INTERVAL_SECONDS=60
PROACTIVE_CHECK_INTERVAL_SECONDS=900
PROACTIVE_WINDOW_DAYS=21
DAILY_NOTIFICATION_CAP=5

# --- Integrations ---
ENCRYPTION_KEY=change-me-to-a-random-secret-encrypt-key=

# --- WhatsApp Business API ---
# Get these from https://developers.facebook.com → Your App → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=your-meta-permanent-system-user-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id-from-meta-console
WHATSAPP_WEBHOOK_VERIFY_TOKEN=senorita_whatsapp_verify
# Optional: comma-separated E.164 numbers to whitelist (leave empty to allow all)
WHATSAPP_ALLOWED_NUMBERS=
WHATSAPP_MESSAGE_POLL_INTERVAL_SECONDS=5
