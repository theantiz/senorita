# --- Database ---
DATABASE_URL=postgresql+asyncpg://senorita:senorita@localhost:5432/senorita

# --- Auth ---
SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Gemini AI ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# --- Embeddings ---
EMBEDDING_MODEL=text-embedding-004

# --- Server ---
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- Workers ---
REMINDER_POLL_INTERVAL_SECONDS=60
PROACTIVE_CHECK_INTERVAL_SECONDS=900
PROACTIVE_WINDOW_DAYS=21
DAILY_NOTIFICATION_CAP=5

# --- Integrations ---
ENCRYPTION_KEY=change-me-to-a-random-secret-encrypt-key=

# --- Gmail ---
GMAIL_CLIENT_ID=your-google-client-id
GMAIL_CLIENT_SECRET=your-google-client-secret
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/integrations/gmail/callback

# --- Slack ---
# Create a Slack App at https://api.slack.com/apps
# Enable Events API, Bot Token Scopes, and redirect URL
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_REDIRECT_URI=http://localhost:8000/api/v1/integrations/slack/callback
